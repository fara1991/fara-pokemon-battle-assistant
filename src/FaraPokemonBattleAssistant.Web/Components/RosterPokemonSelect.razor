@using FaraPokemonBattleAssistant.Core.Roster
@* 登録済みのポケモンから選ぶ入力欄（「登録チームから選ぶ」がオンのときの、ポケモンの入力欄）。
   候補は、ヘッダーのバトル形式の登録チームのメンバー（チームで持たせた持ち物つき）だけ。チームに入っていない育成ポケモンは出さない。選んだ構成は写しで、登録データは変わらない。 *@
<SearchableSelect TItem="Option"
    Items="options"
    DisplayText="@(o => o.Text)"
    GroupSelector="@(o => o.Group)"
    ValueSelector="@(o => o.Choice.Key)"
    SelectedValue="@(SelectedKey ?? "")"
    SelectedValueChanged="OnChanged"
    Placeholder="登録チームから選ぶ…">
    <ItemTemplate Context="o">
        <PokemonIcon Pokemon="o.Pokemon" Small="true" /><span>@o.Choice.Label</span><PokemonTypes Pokemon="o.Pokemon" Small="true" />
    </ItemTemplate>
</SearchableSelect>

@code {
    /// <summary><paramref name="Group"/> はチームの見出し（「チーム1（使用中）」など）。入力欄の文字（Text）には使用中を付けない。</summary>
    private sealed record Option(RosterChoice Choice, Pokemon? Pokemon, string Group)
    {
        public string Text => $"{Choice.Label}（{Group.Replace("（使用中）", "")}）";
    }

    [Parameter] public IReadOnlyList<RosterChoiceGroup> Groups { get; set; } = Array.Empty<RosterChoiceGroup>();
    [Parameter, EditorRequired] public PokemonDataSet Data { get; set; } = default!;
    /// <summary>いま選んでいる登録の Key（<see cref="RosterChoice.Key"/>）。</summary>
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public EventCallback<RosterChoice> OnPick { get; set; }

    private IReadOnlyList<Option> options = Array.Empty<Option>();

    protected override void OnParametersSet() =>
        options = Groups.SelectMany(g => g.Choices.Select(c =>
            new Option(c, Data.FindPokemon(c.Entry.PokemonId), g.Label))).ToList();

    private async Task OnChanged(string key)
    {
        var option = options.FirstOrDefault(o => o.Choice.Key == key);
        if (option is not null) await OnPick.InvokeAsync(option.Choice);
    }
}

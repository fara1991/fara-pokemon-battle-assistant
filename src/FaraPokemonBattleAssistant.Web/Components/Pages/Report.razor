@page "/report"
@using System.Text
@inject HttpClient Http
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>作者へ報告 | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>作者へ報告</h3>
    <p class="text-muted mb-0">不具合・要望・ご意見を、作者に直接送れます。いただいた内容は、作者に通知されます（公開はされません）。</p>
</div>

@* PC: 見出しは固定にして、カードの中だけがスクロールする *@
<div class="pane-scroll">
<MudCard Elevation="0" Class="card mb-3 report-card">
    <MudCardContent Class="card-body">
        @if (sent)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" NoIcon="true">送信しました。ありがとうございます。返信が必要な場合は、書いていただいた連絡先にお返事することがあります。</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3" OnClick="StartOver">もう 1 件送る</MudButton>
        }
        else
        {
            @if (disabled)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" NoIcon="true" Class="mb-3">いまは報告を受け付けていません。お急ぎの場合は、<a href="about-author">作者・問い合わせ</a>の連絡先へお願いします。</MudAlert>
            }
            <div class="form-group mb-3">
                <label class="form-label" for="report-category">種類</label>
                <MudSelect T="string" Value="@form.Category" ValueChanged="@(v => form.Category = v ?? "")" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="app-select" InputId="report-category" Placeholder="選んでください">
                    @foreach (var (id, label) in ReportForm.Categories)
                    {
                        <MudSelectItem T="string" Value="@id">@label</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="form-group mb-3">
                <label class="form-label" for="report-message">内容 <small class="text-muted">（@ReportForm.MinMessage〜@ReportForm.MaxMessage 文字。いま @form.Message.Trim().Length 文字）</small></label>
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-field" InputId="report-message" Lines="6" AutoGrow="false" MaxLength="@ReportForm.MaxMessage" Immediate="true"
                              Value="@form.Message" ValueChanged="@(v => form.Message = v ?? "")"
                              Placeholder="例: ダメージ計算機で、〇〇を選ぶと結果が出ません（使っているゲーム・操作の手順も書いてもらえると助かります）" />
            </div>
            <div class="form-group mb-3">
                <label class="form-label" for="report-contact">連絡先（任意） <Help Title="連絡先">返信が欲しいときだけ、メールアドレスや Twitter の ID などを書いてください。書かなくても送れます。</Help></label>
                <MudTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Class="app-field" InputId="report-contact" MaxLength="@ReportForm.MaxContact"
                              Value="@form.Contact" ValueChanged="@(v => form.Contact = v ?? "")" Placeholder="返信が必要なときだけ" />
            </div>
            @* ボット対策の罠。人には見えない（CSS で画面の外に出す）。入っていたら、サーバーは何も送らずに成功を返す *@
            <div class="report-trap" aria-hidden="true">
                <label>ウェブサイト <input type="text" tabindex="-1" autocomplete="off" @bind="form.Website" /></label>
            </div>
            <div id="report-turnstile" class="mb-3"></div>
            @if (!string.IsNullOrEmpty(error))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" NoIcon="true" Class="mb-3">@error</MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendAsync" Disabled="@(sending || disabled)">@(sending ? "送信中…" : "送信する")</MudButton>
            <p class="small text-muted mt-3 mb-0">送信すると、<a href="privacy">プライバシーポリシー</a>に書いたとおり、内容が作者に通知されます。個人情報（パスワード・アクセスキーなど）は書かないでください。</p>
        }
    </MudCardContent>
</MudCard>
</div>

@code {
    /// <summary>報告のきっかけになったページ（フッターのリンクが ?from= に付ける。パスだけ）。</summary>
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    private ReportForm form = new();
    private bool sent;
    private bool sending;
    private bool disabled;
    private string error = "";
    private bool mounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 送信後に「もう 1 件送る」で戻ったときも、確認の欄を作り直す
        if (sent || mounted) return;
        try
        {
            mounted = true;
            var enabled = await JS.InvokeAsync<bool>("faraReport.mount", "report-turnstile");
            if (!enabled)
            {
                disabled = true;
                StateHasChanged();
            }
        }
        catch
        {
            // JS が使えない・確認の部品を読み込めないとき
            mounted = false;
            disabled = true;
            StateHasChanged();
        }
    }

    private async Task SendAsync()
    {
        if (sending) return;
        error = "";
        form.Page = ReportForm.CleanPage(From);
        try { form.TurnstileToken = await JS.InvokeAsync<string>("faraReport.token") ?? ""; } catch { form.TurnstileToken = ""; }
        if (form.Validate() is { } problem) { error = problem; return; }
        sending = true;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Post, "api/report") { Content = new StringContent(form.ToJson(), Encoding.UTF8, "application/json") };
            using var response = await Http.SendAsync(request);
            if (response.IsSuccessStatusCode)
            {
                sent = true;
                mounted = false;
                await JS.InvokeVoidAsync("faraReport.dispose");
                return;
            }
            error = ReportForm.DescribeFailure((int)response.StatusCode, await response.Content.ReadAsStringAsync());
            await JS.InvokeVoidAsync("faraReport.reset");   // 確認は 1 回で使い切りなので、やり直せるように作り直す
        }
        catch (HttpRequestException)
        {
            error = "通信できませんでした。通信の状態を確かめて、もう一度お試しください";
            await JS.InvokeVoidAsync("faraReport.reset");
        }
        finally
        {
            sending = false;
        }
    }

    private void StartOver()
    {
        form = new ReportForm();
        sent = false;
        error = "";
        mounted = false;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("faraReport.dispose"); } catch { /* ページを離れるだけなので、失敗しても何もしない */ }
    }
}

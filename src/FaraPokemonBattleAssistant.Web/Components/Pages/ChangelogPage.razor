@page "/changelog"
@inherits AppPageBase
@inject HttpClient Http
@inject Changelog Log

<PageTitle>更新履歴 | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h1 class="h3">更新履歴</h1>
    <p class="text-muted mb-0">サイトの機能追加・変更の記録です（新しい順）。</p>
</div>

@* PC: 見出しは固定にして、カードの中だけがスクロールする *@
<div class="pane-scroll">
<MudCard Elevation="0" Class="card mb-3">
    <MudCardContent Class="card-body">
        <h6 class="card-title">サイト内ポケモンデータの更新 <Help Title="サイト内ポケモンデータの更新">ポケモン・技・持ち物・使用率のデータは毎週月曜の昼に自動で更新されます。更新後にページを再読み込みすると新しいデータになります。</Help></h6>
        <table class="table table-sm mb-0 small">
            <tbody>
                <tr><th class="text-nowrap">最終更新</th><td>@(lastUpdated ?? "取得中…")</td></tr>
                <tr><th class="text-nowrap">次回更新</th><td>@nextUpdate</td></tr>
            </tbody>
        </table>
    </MudCardContent>
</MudCard>

@if (failed)
{
    <Notice Class="mb-3">更新履歴を読み込めませんでした。ページを再読み込みしてください。</Notice>
}
else if (entries is null)
{
    <p class="text-muted">読み込み中…</p>
}
else
{
    @foreach (var e in entries)
    {
        <MudCard Elevation="0" Class="card mb-3 changelog-entry">
            <MudCardContent Class="card-body">
                <div class="changelog-date">@e.Date.ToString("yyyy/MM/dd")</div>
                <h5 class="card-title">@e.Title</h5>
                @if (e.Items.Count > 0)
                {
                    <ul class="mb-0 small">
                        @foreach (var item in e.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </MudCardContent>
        </MudCard>
    }
}
</div>

@code {
    // update-data.yml の cron（17 3 * * 1 UTC = 毎週月曜 12:17 JST）
    private static readonly TimeSpan UpdateTimeUtc = new(3, 17, 0);
    private static readonly TimeSpan Jst = TimeSpan.FromHours(9);

    private IReadOnlyList<ChangelogEntry>? entries;
    private bool failed;
    private string? lastUpdated;
    private string nextUpdate = "";

    protected override async Task OnAppReadyAsync()
    {
        nextUpdate = FormatJst(NextUpdateUtc(DateTime.UtcNow));
        try
        {
            entries = await Log.LoadAsync();
        }
        catch
        {
            failed = true;
        }
        try
        {
            // データと同じ読み方にする（ファイルが無いと SPA のフォールバックで index.html が 200 で返るため）
            var text = (await new HttpDataSource(Http, HttpDataSource.GameDataPath).ReadTextAsync("updated.txt"))?.Trim();
            lastUpdated = string.IsNullOrEmpty(text) ? "不明" : DateTime.TryParse(text, null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var dt)
                ? FormatJst(dt)
                : text;
        }
        catch
        {
            lastUpdated = "不明";
        }
    }

    private static DateTime NextUpdateUtc(DateTime nowUtc)
    {
        var candidate = nowUtc.Date + UpdateTimeUtc;
        while (candidate.DayOfWeek != DayOfWeek.Monday || candidate <= nowUtc)
            candidate = candidate.AddDays(1);
        return DateTime.SpecifyKind(candidate, DateTimeKind.Utc);
    }

    private static string FormatJst(DateTime utc)
    {
        var jst = utc + Jst;
        var day = jst.DayOfWeek switch
        {
            DayOfWeek.Monday => "月", DayOfWeek.Tuesday => "火", DayOfWeek.Wednesday => "水", DayOfWeek.Thursday => "木",
            DayOfWeek.Friday => "金", DayOfWeek.Saturday => "土", _ => "日",
        };
        return $"{jst:yyyy/MM/dd}（{day}）{jst:HH:mm} 日本時間";
    }
}

@page "/my-team"
@inherits RosterPageBase
@using FaraPokemonBattleAssistant.Core.Roster
@using RosterTeam = FaraPokemonBattleAssistant.Core.Roster.Team

<PageTitle>自分チーム | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h3>自分チーム <Help Title="自分チーム">登録したポケモンをチームにまとめ、持ち物を決めます。ここには、画面上部の「バトル形式」で選んでいる形式（シングル／ダブル）のチームだけが出ます。形式を切り替えると、その形式のチームが出ます（もう一方のチームは消えません）。チームを「使用中」にすると、ダメージ計算機・素早さ比較・チャットコマンドでその構成が自動で使われます。データはゲームごとに分かれています。</Help></h3>
    <p class="text-muted mb-0">チームが 0 体になると自動で削除されます。先に<a href="my-pokemon">育成ポケモン</a>でポケモンを登録してください。</p>
    <RegistrationStorageNote />
</div>

@if (dataSet is { CalcSupported: false })
{
    <CalcUnsupported DataSet="dataSet" Feature="「自分チーム」ページ" />
}
else if (data is not null && roster is not null && dataSet is not null)
{
    @* PC: 左（チームへの追加）と右（チーム一覧）がそれぞれ画面内に収まり、中だけがスクロールする *@
    <div class="reg-layout pane-fill">
        <div class="reg-col">
            @if (roster.Pokemon.Count == 0)
            {
                <Notice Empty="true" Class="mb-3">登録したポケモンがまだありません。先に<a href="my-pokemon">育成ポケモン</a>で登録してください。</Notice>
            }
            <MudCard Elevation="0" Class="card mb-3">
                <MudCardHeader Class="card-header"><CardHeaderContent><h5>チームに追加 <Help Title="チーム">1 チーム 6 体まで（ダブルでも 6 体まで登録できます）。同じ登録 ID をもう一度追加すると持ち物を更新します。新しいチームは、画面上部の「バトル形式」で選んでいる形式になります（チームごとに形式を変える欄はありません）。チーム番号は、シングルとダブルで共通です（他の形式で使っている番号には追加できません）。メガシンカ後のポケモンはメガストーンが自動で付きます。</Help></h5></CardHeaderContent></MudCardHeader>
                <MudCardContent Class="card-body">
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label">チーム番号</label>
                            <input type="number" class="form-control" min="1" value="@s.TeamNumber" @onchange="@(e => s.TeamNumber = Math.Max(1, ParseId(e.Value)))" />
                        </div>
                        @if (OtherFormatTeamWithNumber is { } other)
                        {
                            <div class="col-12 form-text text-danger team-number-conflict mt-1">チーム@(other.Number) は@(TeamFormats.Label(other.BattleFormat))のチームです。別の番号にしてください</div>
                        }
                        <div class="col-12">
                            <label class="form-label">登録ポケモン</label>
                            <SearchableSelect TItem="RegisteredPokemon" Items="roster.Pokemon" DisplayText="@(e => $"#{e.Id} {e.PokemonName}（{e.Nature}）")" ValueSelector="@(e => e.Id.ToString())"
                                SelectedValue="@(s.TeamEntryId == 0 ? "" : s.TeamEntryId.ToString())" SelectedValueChanged="@OnTeamEntryChanged" Dropdown="true" Placeholder="登録ポケモンを選ぶ...">
                                <ItemTemplate Context="e">
                                    @{ var entryPokemon = data.FindPokemon(e.PokemonId); }
                                    <PokemonIcon Pokemon="entryPokemon" Small="true" /><span>#@e.Id @e.PokemonName（@e.Nature）</span><PokemonTypes Pokemon="entryPokemon" Small="true" />
                                </ItemTemplate>
                            </SearchableSelect>
                        </div>
                        <div class="col-12">
                            <label class="form-label">持ち物</label>
                            @if (TeamEntryIsMega)
                            {
                                <FixedField Value="@s.TeamItem?.Name" Item="s.TeamItem" Reason="@FixedField.MegaReason" />
                            }
                            else
                            {
                                <div class="with-desc">
                                    <SearchableSelect TItem="Item"
                                        Items="data.Items.Where(i => !i.IsMegaStone)"
                                        DisplayText="@(i => i.Name)"
                                        ValueSelector="@(i => i.Id.ToString())"
                                        SelectedValue="@(s.TeamItem?.Id.ToString() ?? "")"
                                        SelectedValueChanged="@(v => s.TeamItem = data.FindItem(ParseId(v)))"
                                        Dropdown="true"
                                        EmptyOption="持ち物なし"
                                        Placeholder="持ち物なし（入力して検索）">
                                        <ItemTemplate Context="held"><ItemLabel Item="held" /></ItemTemplate>
                                    </SearchableSelect>
                                    <DescHelp Name="@(s.TeamItem?.Name)" Description="@(s.TeamItem?.Description)" />
                                </div>
                            }
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="AddToTeamAsync" Disabled="@(s.TeamEntryId == 0 || s.TeamNumber < 1 || OtherFormatTeamWithNumber is not null)">チームに追加</MudButton>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="reg-col">
            @if (roster.Teams.Count == 0)
            {
                <Notice Empty="true" Class="mb-3">まだチームがありません。左のフォームからチームに追加すると、ここに表示されます。</Notice>
            }
            else if (VisibleTeams.Count == 0)
            {
                <Notice Empty="true" Class="mb-3">@(FormatLabel)のチームはまだありません。左のフォームからチームに追加すると、ここに表示されます。</Notice>
            }
            @if (ActiveTeamInOtherFormat is { } hiddenActive)
            {
                <Notice Class="mb-3 team-active-hidden">使用中のチーム@(hiddenActive.Number) は@(TeamFormats.Label(hiddenActive.BattleFormat))のチームです。画面上部の「バトル形式」を@(TeamFormats.Label(hiddenActive.BattleFormat))にすると表示されます。</Notice>
            }
            @foreach (var team in VisibleTeams)
            {
                var isActive = roster.ActiveTeam == team.Number;
                <div class="card mb-3 @(isActive ? "border-primary" : "")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">チーム@(team.Number) @(isActive ? "（使用中）" : "")</h5>
                        <div class="d-flex flex-wrap align-items-center gap-1">
                            @if (!isActive)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="me-1" OnClick="@(() => UseTeamAsync(team.Number))">このチームを使用</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" Class="me-1" OnClick="UnuseTeamAsync">使用を解除</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveTeamAsync(team.Number))">チーム削除</MudButton>
                        </div>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach (var slot in team.Slots)
                        {
                            var entry = roster.Pokemon.FirstOrDefault(p => p.Id == slot.EntryId);
                            var item = slot.ItemId is { } iid ? data.FindItem(iid) : null;
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div class="min-w-0"><span>#@slot.EntryId <PokemonLabel Pokemon="entry is null ? null : data.FindPokemon(entry.PokemonId)" Small="true" /> <small class="text-muted">@(entry is null ? "" : NatureText(entry.Nature)) @(entry?.EVs.ToShortString())</small> <ItemLabel Item="item" /></span>
                                    @if (entry is { MoveIds.Count: > 0 })
                                    {
                                        <div class="small reg-moves">技：@foreach (var mid in entry.MoveIds)
                                        {
                                            if (data.FindMove(mid) is { } mv) { <span class="reg-move"><TypeIcon Type="@mv.Type" Small="true" />@mv.Name</span> }
                                        }</div>
                                    }
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="@(() => RemoveFromTeamAsync(team.Number, slot.EntryId))">外す</MudButton>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="text-muted">@(LoadFailed ? "データを読み込めませんでした。ページを開き直してください。" : "読み込み中…")</div>
}

@code {
    public sealed class State
    {
        public string DataSetKey { get; set; } = "";
        public int TeamNumber { get; set; } = 1;
        public int TeamEntryId { get; set; }
        public Item? TeamItem { get; set; }
    }

    private State s = new();

    protected override string StateKey => "team";

    protected override async Task OnAppReadyAsync()
    {
        s = PageStates.Get<State>(StateKey);
        await base.OnAppReadyAsync();
    }

    protected override void OnDataLoaded()
    {
        if (s.DataSetKey != App.DataSetKey)
        {
            s.DataSetKey = App.DataSetKey;
            s.TeamItem = null;
            s.TeamEntryId = 0;
        }
    }

    private string FormatLabel => TeamFormats.Label(App.Format);

    /// <summary>画面上部の「バトル形式」と同じ形式のチーム。ほかの形式のチームは、データは残したまま表示・操作しない。</summary>
    private IReadOnlyList<RosterTeam> VisibleTeams =>
        roster?.Teams.Where(t => t.BattleFormat == App.Format).ToList() ?? new List<RosterTeam>();

    /// <summary>入力中のチーム番号を、ほかの形式のチームが使っているとき、そのチーム（チーム番号はシングルとダブルで共通のため、追加できない）。</summary>
    private RosterTeam? OtherFormatTeamWithNumber =>
        roster?.Teams.FirstOrDefault(t => t.Number == s.TeamNumber && t.BattleFormat != App.Format);

    /// <summary>使用中のチームが、ほかの形式のチームのとき、そのチーム（使用中は変えないので、一覧に出ない理由を知らせる）。</summary>
    private RosterTeam? ActiveTeamInOtherFormat =>
        roster?.Teams.FirstOrDefault(t => t.Number == roster.ActiveTeam && t.BattleFormat != App.Format);

    private bool TeamEntryIsMega =>
        roster?.Pokemon.FirstOrDefault(p => p.Id == s.TeamEntryId) is { } entry && data?.FindPokemon(entry.PokemonId)?.FixedItemId is not null;

    private void OnTeamEntryChanged(string value)
    {
        var previousFixed = s.TeamEntryId > 0 && roster?.Pokemon.FirstOrDefault(p => p.Id == s.TeamEntryId) is { } previousEntry
            ? data?.FindPokemon(previousEntry.PokemonId)?.FixedItemId : null;
        s.TeamEntryId = ParseId(value);
        var entry = roster?.Pokemon.FirstOrDefault(p => p.Id == s.TeamEntryId);
        var pokemon = entry is null ? null : data?.FindPokemon(entry.PokemonId);
        if (pokemon?.FixedItemId is { } fixedItemId)
            s.TeamItem = data?.FindItem(fixedItemId);
        else if (s.TeamItem?.IsMegaStone == true || previousFixed is not null && s.TeamItem?.Id == previousFixed)
            s.TeamItem = null;   // 前のポケモンで固定されていた持ち物は、引き継がない
    }

    private async Task AddToTeamAsync()
    {
        var key = App.DataSetKey;
        var format = App.Format;
        if (OtherFormatTeamWithNumber is { } other)
        {
            Toast.Warning($"チーム{other.Number} は{TeamFormats.Label(other.BattleFormat)}のチームです。別の番号にしてください");
            return;
        }
        await MutateAsync(async () =>
        {
            var (team, _, replaced) = await Repo.AddToTeamAsync(key, s.TeamNumber, s.TeamEntryId, s.TeamItem, format);
            Show($"チーム{team.Number} に{(replaced ? "更新" : "追加")}しました（{team.Slots.Count}/6）", false);
        });
    }

    private async Task RemoveFromTeamAsync(int teamNo, int entryId)
    {
        var key = App.DataSetKey;
        await MutateAsync(async () =>
        {
            await Repo.RemoveFromTeamAsync(key, teamNo, e => e.Id == entryId);
            if ((await Repo.GetAsync()).For(key).Teams.All(t => t.Number != teamNo))
                Show($"チーム{teamNo} は 0 体になったので削除しました", false);
        });
    }

    private async Task RemoveTeamAsync(int teamNo)
    {
        var key = App.DataSetKey;
        if (Mutating) return;   // 実行中の操作があるあいだは、確認も出さない
        if (!await ConfirmAsync($"チーム{teamNo} を削除します（登録したポケモンは残ります）。よろしいですか？")) return;
        await MutateAsync(async () =>
        {
            await Repo.RemoveTeamAsync(key, teamNo);
            Show($"チーム{teamNo} を削除しました", false);
        });
    }

    private async Task UnuseTeamAsync()
    {
        var key = App.DataSetKey;
        await MutateAsync(async () =>
        {
            await Repo.ClearActiveTeamAsync(key);
            Show("使用チームを解除しました", false);
        });
    }

    private async Task UseTeamAsync(int teamNo)
    {
        var key = App.DataSetKey;
        await MutateAsync(async () =>
        {
            if (await Repo.UseTeamAsync(key, teamNo))
                Show($"チーム{teamNo} を使用します", false);
            else
                Toast.Warning($"チーム{teamNo} はありません（他の場所で削除された可能性があります）");
        });
    }
}

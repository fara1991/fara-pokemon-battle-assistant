@page "/"
@inherits AppPageBase
@inject Changelog Log

<PageTitle>ホーム | Pokémon Battle Assistant</PageTitle>

<div class="page-header">
    <h1 class="home-title">Pokémon Battle Assistant</h1>
    <p class="text-muted mb-0 home-lead">ダメージ計算・素早さ比較・育成済みポケモンとチームの管理・タイプ相性をまとめたサイトです。配信中は Twitch のチャットコマンドからも同じ機能を使えます。</p>
</div>

@* PC: 見出しは固定にして、カードの並びの中だけがスクロールする *@
<div class="pane-scroll">
@* 上に対応ゲーム、中に機能の一覧、一番下に更新履歴（どの機能も同じ大きさで並べる） *@
<div class="row g-3">
    <div class="col-12">
        <MudCard Elevation="0" Class="card h-100">
            <MudCardContent Class="card-body">
                <h6 class="card-title">対応しているゲーム <Help Title="ゲームの切り替え">左のメニューの「ゲーム」で切り替えます。選んだゲームは全ページとチャットコマンドの接頭辞に反映されます。</Help></h6>
                <ul class="mb-0 small">
                    <li>第1・第2世代: その世代のポケモン・技・タイプ相性を見られます。ダメージ計算は未対応です</li>
                    <li>第3世代以降: その世代の計算式と補正でダメージを計算します<br /><span class="text-muted">※メガシンカ、Z 技、ダイマックス、テラスタルに対応しています（それぞれ登場した世代のみ）</span></li>
                    <li>ポケモンチャンピオンズ: 収録ポケモンのダメージ計算、努力値のポイント制に対応しています</li>
                </ul>
            </MudCardContent>
        </MudCard>
    </div>
</div>

<MudCard Elevation="0" Class="card mt-3">
    <MudCardHeader Class="card-header fw-bold"><CardHeaderContent>機能</CardHeaderContent></MudCardHeader>
    <ul class="home-tools home-tools-2col">
        <li>
            <div class="home-tool-text"><b>ダメージ計算機</b><p>努力値・性格・持ち物・特性・ランク補正・天候・フィールドなどを指定して、乱数 16 通りのダメージと確定数を出します。受けたダメージから相手の振り方を推定することもできます。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="damage-calculator">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>チャットコマンド</b><p>配信中に <code>!@(App.CommandPrefix) dmg ガブリアス じしん リザードン</code> のように打つと、配信用BOTが結果を 1 行で返します。ブラウザでも試せます。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="chat-commands">コマンドを試す</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>育成ポケモン・自分チーム</b><p>育成済みのポケモンとチームを登録しておくと、計算のときに自分の構成が自動で入ります（<code>!@(App.CommandPrefix) add -m / add -t / use -t</code>）。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="my-pokemon">育成ポケモン</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="my-team">自分チーム</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>相手チーム</b><p>対戦中の相手を登録して、分かった振り方・性格・特性や推定をダメージ計算に使います。試合を終えると履歴に残ります（<code>!@(App.CommandPrefix) add -r / scan / clear -r</code>）。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="my-rival">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>素早さ比較</b><p>2 体のポケモンの S を比べて、どちらが先に動くかを確認します（チャットでは <code>!@(App.CommandPrefix) faster</code>）。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="speed-comparison">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>タイプ相性表</b><p>18 タイプの相性をアイコンで一覧できます。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="type-chart">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>ポケモン一覧</b><p>選んでいるゲームのポケモンを全国図鑑順に一覧し、タイプ・特性・覚える技で絞り込んだり、種族値で並べ替えたりできます。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="pokemon-list">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>わざ一覧</b><p>選んでいるゲームの技を、タイプ・分類・威力・命中・PP・説明とあわせて一覧し、技を選ぶとその技を覚えるポケモンを調べられます。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="move-list">開く</MudButton></div>
        </li>
        <li>
            <div class="home-tool-text"><b>用語・略語</b><p>H・A・B・C・D・S などの略語と、種族値・努力値・確定数などの用語の意味をまとめています。</p></div>
            <div class="home-tool-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="battle-terms">開く</MudButton></div>
        </li>
    </ul>
</MudCard>

<MudCard Elevation="0" Class="card mt-3">
    <MudCardContent Class="card-body">
        <h6 class="card-title">更新履歴</h6>
        @if (recent is null)
        {
            <p class="small text-muted mb-0">@(failed ? "読み込めませんでした" : "読み込み中…")</p>
        }
        else
        {
            <ul class="changelog-recent small">
                @foreach (var e in recent)
                {
                    <li><span class="changelog-date">@e.Date.ToString("MM/dd")</span> @e.Title</li>
                }
            </ul>
        }
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Href="changelog">すべて見る</MudButton>
    </MudCardContent>
</MudCard>


</div>

@code {
    /// <summary>ホームに出す更新履歴の件数（細かい内容は更新履歴ページ）。</summary>
    private const int RecentCount = 3;

    private IReadOnlyList<ChangelogEntry>? recent;
    private bool failed;

    protected override async Task OnAppReadyAsync()
    {
        try
        {
            recent = (await Log.LoadAsync()).Take(RecentCount).ToList();
        }
        catch
        {
            failed = true;
        }
    }
}

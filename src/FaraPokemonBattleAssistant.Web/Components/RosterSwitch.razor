@using FaraPokemonBattleAssistant.Core.Roster
@* 「登録から選ぶ」のスイッチ（MudBlazor の MudSwitch）。オンにすると、ポケモンの入力欄の候補が登録済みのポケモンだけになる（RosterPokemonSelect）。
   登録が 1 件もなければスイッチは出さず、登録ページへの案内だけを出す。 *@
@if (Groups.Count > 0)
{
    <div class="roster-switch mb-2">
        <MudSwitch T="bool" Value="@Enabled" ValueChanged="@(v => EnabledChanged.InvokeAsync(v))" Color="Color.Primary" Size="Size.Small" Label="登録から選ぶ" LabelPlacement="Placement.End" Class="roster-switch-input" />
        <Help Title="登録から選ぶ">オンにすると、ポケモンの候補が登録済みのポケモン（チームのメンバーと、チームに入っていない登録）だけになり、選ぶと登録した性格・努力値（ポイント）・特性と、チームで持たせた持ち物が入ります。入れたあとに値を変えても、登録データは変わりません。オフのときは、すべてのポケモンから選べます。</Help>
    </div>
}
else if (ShowEmptyHint)
{
    <Notice Empty="true" Class="mb-2">登録したポケモンの構成を呼び出せます（<a href="data-share">データ共有</a>・<a href="my-pokemon">育成ポケモン</a>で登録）。</Notice>
}

@code {
    [Parameter] public IReadOnlyList<RosterChoiceGroup> Groups { get; set; } = Array.Empty<RosterChoiceGroup>();
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public EventCallback<bool> EnabledChanged { get; set; }
    /// <summary>登録が無いときに案内を出すか（読み込みに失敗したときは出さない）。</summary>
    [Parameter] public bool ShowEmptyHint { get; set; } = true;
}

# Cloudflare の静的アセットに付けるヘッダー（Worker の /api/* には付かない）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Cloudflare の Web Analytics（ダッシュボードで自動挿入に設定済み）のスクリプトと送信先を許可している。
  # 外部から読み込めるのは、ここに書いたものだけ。新しい外部のスクリプト・フォント・画像・接続先を使うときは、ここにも足すこと（足さないとブロックされる）
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Cloudflare の静的アセットに付けるヘッダー（Worker の /api/* には付かない）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Cloudflare の Web Analytics（ダッシュボードで自動挿入に設定済み）のスクリプトと送信先を許可している。
  # まずは違反を記録するだけ（Report-Only）。ブラウザのコンソールで違反が出ないことを確かめてから、Content-Security-Policy に切り替える
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: https://raw.githubusercontent.com; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

@* サイドバーの中身（MudBlazor の MudNavMenu / MudNavLink）。PC は Shared/MainLayout.razor の Mini ドロワーに入り、隠すとアイコンだけの細い列になる。
   スマホは、ハンバーガーで開く一時的なメニューで、上のほうに、全ページ共通の設定（ゲーム・バトル形式・ライト／ダーク・対戦画面で表示）を置く *@
@using MudBlazor
@inject AppState App
@implements IDisposable

@if (Mobile)
{
    <div class="side-settings px-3 pt-3">
        <label class="side-label" for="side-dataset">ゲーム <Help Title="ゲーム（データ）">計算に使うポケモン・技・持ち物のデータを切り替えます。チャットコマンドの接頭辞（!pokech など）もこれに合わせて変わります。全ページ共通です。</Help></label>
        <select id="side-dataset" class="form-select form-select-sm" value="@App.DataSetKey" @onchange="@(e => App.SetDataSetAsync(e.Value?.ToString() ?? ""))">
            @foreach (var ds in App.DataSets)
            {
                <option value="@ds.Key">@ds.Name</option>
            }
        </select>
        @if (UsageFallbackName is { } fallbackName)
        {
            <div class="side-note">使用率は公開されていないため、@(fallbackName) の使用率で並べています</div>
        }
        <label class="side-label mt-2" for="side-format">バトル形式 <Help Title="バトル形式">ダブルバトルでは全体技の威力が 0.75 倍になります。使用率の既定値（技・持ち物・性格）もシングル / ダブルで切り替わります。</Help></label>
        <select id="side-format" class="form-select form-select-sm" value="@App.Format" @onchange="@(e => App.SetFormatAsync(Enum.TryParse<BattleFormat>(e.Value?.ToString(), out var f) ? f : BattleFormat.Singles))">
            <option value="@BattleFormat.Singles">シングル</option>
            <option value="@BattleFormat.Doubles">ダブル</option>
        </select>
        <button type="button" class="btn btn-sm btn-outline-light w-100 mt-2" @onclick="App.ToggleThemeAsync">
            @(App.Theme == "dark" ? "☀ ライトモード" : "🌙 ダークモード")
        </button>
        @* 対戦画面（背景のフィールドに結果を重ねて出す）。ダメージ計算機・素早さ比較・育成ポケモンで使え、全ページ共通のスイッチ *@
        <BattleViewSwitch InputId="side-battle-view" Class="side-battle mt-2" OnChanged="OnNavigate" />
    </div>
}

<MudNavMenu Class="side-nav">
    @foreach (var group in Groups)
    {
        @if (group.Title is not null)
        {
            <div class="nav-section">@group.Title</div>
        }
        @foreach (var (href, label, icon, needsCalc) in group.Items)
        {
            @if (needsCalc && CalcDisabled)
            {
                @* 未対応の世代: 選べず、押しても何も起きない（メニューも閉じない） *@
                <MudNavLink Disabled="true" Icon="@icon" title="@DisabledHint">@label</MudNavLink>
            }
            else
            {
                <MudNavLink Href="@href" Match="@(href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@icon" OnClick="OnNavigate">@label</MudNavLink>
            }
        }
    }
</MudNavMenu>

@code {
    /// <summary>スマホのメニュー（上のほうに共通の設定を出す）かどうか。</summary>
    [Parameter] public bool Mobile { get; set; }

    /// <summary>項目を選んだとき・スイッチを切り替えたときに呼ぶ（スマホでメニューを閉じる）。</summary>
    [Parameter] public EventCallback OnNavigate { get; set; }

    private sealed record NavGroup(string? Title, (string Href, string Label, string Icon, bool NeedsCalc)[] Items);

    /// <summary>メニューの項目（needsCalc: 計算・登録に対応していないゲームでは選べない）。見出しで分ける。</summary>
    private static readonly NavGroup[] Groups =
    {
        new(null, new[]
        {
            ("", "ホーム", Icons.Material.Filled.Home, false),
        }),
        new("計算", new[]
        {
            ("damage-calculator", "ダメージ計算機", Icons.Material.Filled.Calculate, true),
            ("speed-comparison", "素早さ比較", Icons.Material.Filled.Speed, true),
        }),
        new("登録", new[]
        {
            ("data-share", "データ共有", Icons.Material.Filled.CloudUpload, false),
            ("my-pokemon", "育成ポケモン", Icons.Material.Filled.PersonAdd, true),
            ("my-team", "自分チーム", Icons.Material.Filled.Groups, true),
            ("my-rival", "相手チーム", Icons.Material.Filled.Face, true),
        }),
        new("情報", new[]
        {
            ("type-chart", "タイプ相性表", Icons.Material.Filled.GridView, false),
            ("pokemon-list", "ポケモン一覧", Icons.Material.Filled.FormatListBulleted, false),
            ("move-list", "わざ一覧", Icons.Material.Filled.Bolt, false),
            ("battle-terms", "用語・略語", Icons.Material.Filled.MenuBook, false),
            ("api-docs", "API", Icons.Material.Filled.Code, false),
        }),
        new("配信", new[]
        {
            ("chat-commands", "チャットコマンド", Icons.Material.Filled.Chat, true),
        }),
        new("サポート", new[]
        {
            ("about-author", "作者・問い合わせ", Icons.Material.Filled.Person, false),
        }),
    };

    // 計算・登録に対応していないゲーム（昔の世代）では、使えない項目を選べなくする。
    // 設定を読み終えるまで（DataSet が決まるまで）も選べなくし、未対応のゲームで一瞬押せてしまうのを防ぐ
    private bool CalcDisabled => App.DataSet is not { CalcSupported: true };

    private string DisabledHint => App.DataSet is null
        ? "読み込み中です"
        : $"{App.DataSet.Name}は未対応です（ポケモン一覧とタイプ相性表のみ）";

    protected override async Task OnInitializedAsync()
    {
        await App.InitializeAsync();
        App.Changed += OnChanged;
    }

    private Task OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => App.Changed -= OnChanged;

    // 使用率データの無いゲームでは、代わりに使っているゲームの名前（並び順の根拠を示す）
    private string? UsageFallbackName =>
        App.DataSet is { UsageFallback.Length: > 0 } ds
            ? App.DataSets.FirstOrDefault(d => d.Key == ds.UsageFallback)?.Name ?? ds.UsageFallback
            : null;
}

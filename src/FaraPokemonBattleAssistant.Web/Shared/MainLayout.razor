@inherits LayoutComponentBase
@inject BattleStage Stage
@inject NavigationManager Nav
@inject MaintenanceInfo Maintenance
@implements IDisposable

@* 背景のバトルフィールド（Shared/BattleStageBackground.razor） *@
<BattleStageBackground />

@* 対戦画面（結果をフィールドの上に重ねて出す。Shared/BattleOverlay.razor）。出している間は main（入力欄）を隠す *@
<BattleOverlay />

@* 共通のレイアウト（fara-site-kit の SiteLayout）: MudBlazor の土台（テーマ・ポップアップ・ダイアログ・通知）・ヘッダー・サイドバー（PC は Mini、スマホは一時的なメニュー）・本文・フッター・お知らせの帯。
   ここでは、サイトの中身だけを渡す。
   - ヘッダー（PC）: 検索欄と、全ページ共通の設定（ゲーム・バトル形式・対戦画面で表示・ライト／ダーク）。
   - ヘッダー（スマホ）: 対戦画面のスイッチと、検索ボタン（下に開く検索欄は SearchSheet）。設定は、メニューの上のほうに同じものがある（NavMenu.razor）。
   - サイドバーの開閉・スマホの判定・検索欄の開閉は SiteLayout が持つ（PC の開閉は、保存のキー SiteInfo.SidebarKey に保存する）。
   - 対戦画面を出している間は、ページのクラスに battle-active を付ける（app.css が main を隠す） *@
<SiteLayout Body="@Body" Maintenance="Maintenance" PageClass="@(Stage.BattleActive ? "battle-active" : null)">
    <SearchBox>
        <SiteSearch />
    </SearchBox>
    <HeaderEnd>
        <HeaderControls />
    </HeaderEnd>
    <MobileHeaderActions>
        @* スマホでは、メニューを開かずに切り替えられるよう、ヘッダーに置く *@
        <BattleViewSwitch InputId="top-battle-view" Class="top-battle" Compact="true" />
    </MobileHeaderActions>
    <SearchSheet Context="closeSearch">
        @* スマホの検索欄（PC の検索欄と同じ部品）。× ・結果を開いたとき・Esc で、SiteLayout が閉じる *@
        <SiteSearch Sheet="true" OnDone="closeSearch" />
    </SearchSheet>
    <DrawerContent Context="closeOnNavigate">
        <NavMenu OnNavigate="closeOnNavigate" />
    </DrawerContent>
</SiteLayout>

@code {
    private string currentGroup = "";

    protected override void OnInitialized()
    {
        Stage.Changed += OnStageChanged;
        currentGroup = GroupOf(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        await Stage.InitializeAsync();
    }

    /// <summary>サイドバーの見出し（計算・登録・情報など）が変わるページの切り替えでは、対戦画面をオフにする。</summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var next = GroupOf(Nav.ToBaseRelativePath(e.Location));
        if (next != currentGroup && Stage.BattleView) Stage.SetBattleView(false);
        currentGroup = next;
    }

    /// <summary>ページ（パス）が、サイドバーのどの見出しに入るか（NavMenu の見出しと同じ分け方）。</summary>
    private static string GroupOf(string relativePath)
    {
        var path = relativePath.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return path switch
        {
            "" => "home",
            "damage-calculator" or "speed-comparison" => "calc",
            "data-share" or "my-pokemon" or "my-team" or "my-rival" => "register",
            "type-chart" or "pokemon-list" or "move-list" or "battle-terms" or "api-docs" => "info",
            "chat-commands" => "stream",
            _ => path,
        };
    }

    private void OnStageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Stage.Changed -= OnStageChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

@inherits LayoutComponentBase
@inject BattleStage Stage
@inject NavigationManager Nav
@implements IDisposable

@* 背景のバトルフィールド（Shared/BattleStageBackground.razor） *@
<BattleStageBackground />

@* 対戦画面（結果をフィールドの上に重ねて出す。Shared/BattleOverlay.razor）。出している間は main（入力欄）を隠す *@
<BattleOverlay />

<div class="page @(Stage.BattleActive ? "battle-active" : "")">
    @* PC の上に固定するヘッダー（ハンバーガーとサイト名）。ハンバーガーを押すたびに、サイドバーの表示・非表示を切り替える（処理は wwwroot/js/page.js）。
       スマホは、サイドバー上部のサイト名とメニューのボタンを使う。キーボードで最初に届くよう、サイドバーの前に置く *@
    <header class="app-header">
        <button type="button" class="sidebar-toggle" data-sidebar-toggle aria-controls="site-sidebar" aria-expanded="true" aria-label="サイドバーの表示・非表示" title="サイドバーの表示・非表示"></button>
        <a class="app-brand" href="/" title="ホームへ">Pokémon Battle Assistant</a>
    </header>

    @* サイドバーを隠しているとき、画面の左端にマウスを近づけると、サイドバーが一時的に出る（CSS の :hover）。ハンバーガーを押すと、出したままにする *@
    <div class="sidebar-edge" aria-hidden="true"></div>

    <div class="sidebar" id="site-sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<Toasts />

@code {
    private string currentGroup = "";

    protected override async Task OnInitializedAsync()
    {
        Stage.Changed += OnStageChanged;
        currentGroup = GroupOf(Nav.ToBaseRelativePath(Nav.Uri));
        Nav.LocationChanged += OnLocationChanged;
        await Stage.InitializeAsync();
    }

    /// <summary>サイドバーの見出し（計算・登録・情報など）が変わるページの切り替えでは、対戦画面をオフにする。</summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var next = GroupOf(Nav.ToBaseRelativePath(e.Location));
        if (next != currentGroup && Stage.BattleView) Stage.SetBattleView(false);
        currentGroup = next;
    }

    /// <summary>ページ（パス）が、サイドバーのどの見出しに入るか（NavMenu の見出しと同じ分け方）。</summary>
    private static string GroupOf(string relativePath)
    {
        var path = relativePath.Split('?', '#')[0].Trim('/').ToLowerInvariant();
        return path switch
        {
            "" => "home",
            "damage-calculator" or "speed-comparison" => "calc",
            "data-share" or "my-pokemon" or "my-team" or "my-rival" => "register",
            "type-chart" or "pokemon-list" or "move-list" or "battle-terms" or "api-docs" => "info",
            "chat-commands" => "stream",
            _ => path,
        };
    }

    private void OnStageChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Stage.Changed -= OnStageChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

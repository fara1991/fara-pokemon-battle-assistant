@* 検索欄。入力するとすぐに、一致した場所（ページ・項目・用語・コマンド・ポケモン・わざ・特性）と、その前後の文章を出す。
   ↑↓ で結果を選び、ポケモンなど別の開き方がある結果は ←→ で選んで、Enter で開く。Esc で閉じる。Ctrl+K（Mac は ⌘K）か「/」で欄に移る（wwwroot/js/page.js）。
   PC はヘッダーに置く。スマホは Sheet（ヘッダーの検索ボタンで、下に開く欄。× で閉じる・結果を開いたら閉じる・Esc で閉じる）。欄の枠（#fbc-search-sheet）の出し入れは、kit の SiteLayout（SearchSheet）が行う。
   探す処理は Services/SearchService.cs。日本語入力の変換中の Enter は、page.js が止める（ここには届かない） *@
@inject SearchService Search
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Esc は、ここで受ける（候補を閉じる・欄を閉じる）。kit の欄（SiteLayout の #fbc-search-sheet）にも Esc で閉じる処理があるので、ここで止める（検索の契約。候補を閉じるだけのときに、欄まで閉じないように） *@
<div class="site-search @(Sheet ? "site-search-sheet" : null)" role="search" @onfocusout="Close" @onfocusin="OnFocusIn" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true">
    <svg class="site-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
    <input id="site-search-input" type="search" class="site-search-input" placeholder="検索（例: ガブリアス、dmg、努力値）" autocomplete="off" spellcheck="false"
           aria-label="サイト内を検索" role="combobox" aria-expanded="@(open ? "true" : "false")" aria-controls="site-search-list" aria-autocomplete="list"
           aria-activedescendant="@ActiveId"
           value="@query" @oninput="OnInput" />
    @if (Sheet)
    {
        <button type="button" class="site-search-close" aria-label="検索を閉じる" title="検索を閉じる" @onclick="Done">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
    }
    else
    {
        <span class="site-search-hint" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
    }
    @if (open)
    {
        @if (hits.Count == 0)
        {
            <div id="site-search-list" tabindex="-1" class="site-search-list" role="status"><div class="site-search-empty">@(loading ? "探しています…" : $"「{query}」に一致するものはありません")</div></div>
        }
        else
        {
        <div id="site-search-list" tabindex="-1" class="site-search-list" role="listbox" aria-label="検索の候補">
            @for (var i = 0; i < hits.Count; i++)
            {
                var hit = hits[i];
                <div class="site-search-row @(i == active ? "is-active" : null)" role="presentation">
                    <a class="site-search-item" role="option" tabindex="-1" id="@OptionId(i, -1)" href="@hit.Url" aria-selected="@(i == active && activeAction < 0 ? "true" : "false")" @onclick="@(e => Go(e, hit.Url))" @onclick:preventDefault="true">
                        <span class="site-search-title"><span class="site-search-kind sk-@hit.Kind">@KindLabel(hit.Kind)</span>@Marked(hit.Title)</span>
                        <span class="site-search-where">@hit.Where</span>
                        @if (hit.Snippet.Length > 0)
                        {
                            <span class="site-search-snippet">@Marked(hit.Snippet)</span>
                        }
                    </a>
                    @if (hit.Actions.Count > 0)
                    {
                        <span class="site-search-actions" role="presentation">
                            @for (var j = 0; j < hit.Actions.Count; j++)
                            {
                                var action = hit.Actions[j];
                                <a class="site-search-chip @(i == active && j == activeAction ? "is-active" : null)" role="option" tabindex="-1" id="@OptionId(i, j)" href="@action.Url" aria-selected="@(i == active && j == activeAction ? "true" : "false")" aria-label="@($"{hit.Title}を{action.Label}で開く")" @onclick="@(e => Go(e, action.Url))" @onclick:preventDefault="true">@action.Label</a>
                            }
                        </span>
                    }
                </div>
            }
        </div>
        }
    }
</div>

@code {
    /// <summary>スマホの検索欄（ヘッダーの下に開く）かどうか。PC の検索欄（ヘッダーの中）とは、見た目と閉じ方が違う</summary>
    [Parameter] public bool Sheet { get; set; }

    /// <summary>スマホの検索欄を閉じるときに呼ぶ（× ・Esc・結果を開いたとき）。SiteLayout が閉じる</summary>
    [Parameter] public EventCallback OnDone { get; set; }

    private string query = "";
    private string[] terms = Array.Empty<string>();
    private IReadOnlyList<SearchHit> hits = Array.Empty<SearchHit>();
    private bool open;
    private bool loading;
    /// <summary>選んでいる結果（-1 は、どれも選んでいない）。</summary>
    private int active = -1;
    /// <summary>選んでいる結果の、別の開き方（-1 は、結果そのもの）。</summary>
    private int activeAction = -1;
    private int generation;

    private static string OptionId(int hit, int action) => action < 0 ? $"site-search-opt-{hit}" : $"site-search-opt-{hit}-{action}";

    private string? ActiveId => open && active >= 0 ? OptionId(active, activeAction) : null;

    private static string KindLabel(string kind) => kind switch
    {
        "page" => "ページ",
        "section" => "項目",
        "term" => "用語",
        "command" => "コマンド",
        "pokemon" => "ポケモン",
        "move" => "わざ",
        "ability" => "特性",
        _ => kind,
    };

    /// <summary>一致した部分を強調した表示にする。</summary>
    private RenderFragment Marked(string text) => builder =>
    {
        foreach (var (part, match) in SearchService.Split(text, terms))
        {
            if (match) { builder.OpenElement(0, "mark"); builder.AddContent(1, part); builder.CloseElement(); }
            else builder.AddContent(2, part);
        }
    };

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        await RunAsync();
    }

    private async Task RunAsync()
    {
        var mine = ++generation;
        terms = SearchService.Terms(query);
        if (terms.Length == 0) { Close(); return; }
        open = true;
        loading = true;
        var result = await Search.SearchAsync(query);
        if (mine != generation) return;   // 古い入力の結果
        hits = result;
        loading = false;
        active = -1;
        activeAction = -1;
    }

    // フォーカスが欄から外れたら閉じる（結果の <a> は Tab の対象にしない・クリックではフォーカスを外さない（page.js）ので、結果を操作している間は欄にある）。
    // 戻ってきたとき、探した結果があれば、また開く
    private void OnFocusIn()
    {
        if (!open && query.Trim().Length > 0 && hits.Count > 0) open = true;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when hits.Count > 0:
                if (!open) { open = true; break; }
                active = active + 1 >= hits.Count ? -1 : active + 1;
                activeAction = -1;
                break;
            case "ArrowUp" when open && hits.Count > 0:
                active = active - 1 < -1 ? hits.Count - 1 : active - 1;
                activeAction = -1;
                break;
            case "ArrowRight" when open && active >= 0 && hits[active].Actions.Count > 0:
                activeAction = Math.Min(activeAction + 1, hits[active].Actions.Count - 1);
                break;
            case "ArrowLeft" when open && active >= 0 && activeAction >= 0:
                activeAction--;
                break;
            case "Enter" when open && !loading && hits.Count > 0:
                var hit = hits[active >= 0 ? active : 0];
                var url = active >= 0 && activeAction >= 0 ? hit.Actions[activeAction].Url : hit.Url;
                Go(null, url);
                break;
            case "Escape" when Sheet && !open:
                await Done();
                break;
            case "Escape":
                Close();
                break;
        }
    }

    /// <summary>
    /// 結果を開く。Ctrl・⌘・Shift を押したクリックは、新しいタブで開く。
    /// 同じページで ?attacker= などだけが変わるときは、各ページが OnParametersSet で反映する（読み込み直さないので、入力した内容は残る）。
    /// </summary>
    private void Go(MouseEventArgs? e, string url)
    {
        Close();
        if (Sheet) _ = Done();
        if (e is { CtrlKey: true } or { MetaKey: true } or { ShiftKey: true })
        {
            _ = JS.InvokeVoidAsync("open", url, "_blank");
            return;
        }
        Nav.NavigateTo(url);
    }

    private void Close()
    {
        open = false;
        active = -1;
        activeAction = -1;
    }

    /// <summary>スマホの欄を閉じる（SiteLayout に知らせる）。PC の欄では、何もしない</summary>
    private Task Done()
    {
        Close();
        return Sheet ? OnDone.InvokeAsync() : Task.CompletedTask;
    }
}
